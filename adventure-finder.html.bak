<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Find campsites, vanlife bases and adventure stays by area, interests, nearby places and facilities with Adventure Builder.">
  <meta name="theme-color" content="#0b0d0f">
  <title>Adventure Finder | Adventure Builder</title>
  <link rel="icon" href="images/adventure-builder-logo.png">
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="css/account-gate.css">
  <link rel="stylesheet" href="css/navigation-shell.css">
  <link rel="stylesheet" href="css/accessibility.css">
  <link rel="stylesheet" href="css/feedback.css">
  <link rel="stylesheet" href="css/community-counter.css">
  <link rel="stylesheet" href="css/profile.css">
  <link rel="stylesheet" href="css/adventure-finder.css">
  
  <link rel="stylesheet" href="css/site-wide-compact-pages.css">
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.7.1/dist/maplibre-gl.css">
</head>
<body data-page="adventure-finder" data-account-required="true">
  <header class="site-header">
    <a class="brand" href="index.html" aria-label="Adventure Builder home">
      <img src="images/adventure-builder-logo.png" alt="Adventure Builder logo">
      <span>Adventure Builder</span>
    </a>
    <div class="account-actions" id="account-actions">
      <button class="header-link" id="open-login" type="button">Log in</button>
      <button class="header-register" id="open-register" type="button">Register</button>
      <button class="account-chip" id="account-chip" type="button" hidden>
        <span class="account-avatar" id="account-avatar">A</span>
        <span id="account-label">My account</span>
      </button>
    </div>
  </header>
  <main class="af-page-shell" data-adventure-finder>
  <section class="af-hero" aria-labelledby="af-page-title">
    <div class="af-hero-overlay"></div>
    <div class="af-hero-content">
      <p class="af-eyebrow">Adventure Finder</p>
      <h1 id="af-page-title">Find the right base for <span>your next adventure.</span></h1>
      <p class="af-hero-copy">Tell us where you’re going, how far you want to travel and what matters to you. We’ll find the best places to stay that put you close to the adventures you love.</p>

      <section class="ab-finder">
        <div class="af-search-strip" aria-label="Adventure Finder search">
          <label class="af-search-cell" for="af-area">
            <span class="af-search-icon" aria-hidden="true">⌖</span>
            <span class="af-search-text"><strong>Where are you going?</strong><small>Choose an area</small></span>
            <input id="af-area" data-af-area value="Lake District" list="af-areas" autocomplete="off" placeholder="Lake District">
            <datalist id="af-areas"><option>Anywhere</option><option>Lake District</option><option>Peak District</option><option>Yorkshire Dales</option><option>Scottish Highlands</option><option>Cornwall</option><option>New Forest</option></datalist>
          </label>
          <label class="af-search-cell" for="af-stay">
            <span class="af-search-icon" aria-hidden="true">⌂</span>
            <span class="af-search-text"><strong>Where do you want to stay?</strong><small>Any type of base</small></span>
            <select id="af-stay" data-af-stay><option>Any stay</option><option>Campsite</option><option>Campervan Site</option><option>Permitted Overnight Stop</option></select>
          </label>
          <label class="af-search-cell" for="af-drive">
            <span class="af-search-icon" aria-hidden="true">◷</span>
            <span class="af-search-text"><strong>How far will you travel?</strong><small>Choose travel time</small></span>
            <select id="af-drive" data-af-drive><option>30 minutes</option><option>1 hour</option><option selected>2 hours</option><option>3 hours</option><option>No limit</option></select>
          </label>
          <button class="af-search-cell af-matters" type="button" data-af-filter-toggle>
            <span class="af-search-icon" aria-hidden="true">♡</span>
            <span class="af-search-text"><strong>What matters to you?</strong><small data-af-matters-summary>Add what’s important</small></span>
          </button>
        </div>

        <div class="af-hero-actions">
          <button class="af-find-button" type="button" data-af-search>FIND MY NEXT ADVENTURE <span aria-hidden="true">→</span></button>
          <button class="af-accessibility-toggle" type="button" data-accessibility-open><span aria-hidden="true">♿</span> Accessibility <small data-accessibility-summary>Accessibility off</small></button>
        </div>
        <p class="af-hero-note"><span>✓</span> We compare campsites, campervan stops and other adventure bases around your chosen area and show the ones that best match you.</p>

        <div class="af-filter-panel" data-af-filters>
          <div class="af-filter-head"><div><p class="af-kicker">What matters to you?</p><h2>Choose only the things that would change your decision.</h2></div><button class="af-link" type="button" data-af-clear>Clear all</button></div>
          <div class="af-filter-groups">
            <fieldset><legend>Who or what needs to fit?</legend><div class="af-options"><button type="button" data-af-choice="dog" aria-pressed="false">Dog friendly</button><button type="button" data-af-choice="tent" aria-pressed="false">Tent</button><button type="button" data-af-choice="van" aria-pressed="false">Van friendly</button><button type="button" data-af-choice="family" aria-pressed="false">Family</button><button type="button" data-af-choice="quiet" aria-pressed="false">Quiet</button></div></fieldset>
            <fieldset><legend>What do you want nearby?</legend><div class="af-options"><button type="button" data-af-choice="hiking" aria-pressed="false">Walks</button><button type="button" data-af-choice="paddle" aria-pressed="false">Paddling</button><button type="button" data-af-choice="lake" aria-pressed="false">Lakes</button><button type="button" data-af-choice="mountain" aria-pressed="false">Mountains</button><button type="button" data-af-choice="waterfall" aria-pressed="false">Waterfalls</button><button type="button" data-af-choice="beach" aria-pressed="false">Beaches</button><button type="button" data-af-choice="forest" aria-pressed="false">Forest</button><button type="button" data-af-choice="wildlife" aria-pressed="false">Wildlife</button><button type="button" data-af-choice="sunset" aria-pressed="false">Sunset views</button><button type="button" data-af-choice="sunrise" aria-pressed="false">Sunrise</button><button type="button" data-af-choice="photo" aria-pressed="false">Photography</button><button type="button" data-af-choice="cafe" aria-pressed="false">Cafés</button><button type="button" data-af-choice="pub" aria-pressed="false">Pubs</button></div></fieldset>
            <fieldset><legend>Facilities</legend><div class="af-options"><button type="button" data-af-choice="showers" aria-pressed="false">Showers</button><button type="button" data-af-choice="toilets" aria-pressed="false">Toilets</button><button type="button" data-af-choice="water" aria-pressed="false">Fresh water</button><button type="button" data-af-choice="electric" aria-pressed="false">Electric</button></div></fieldset>
            <fieldset class="af-van-fieldset"><legend>My Van</legend><label class="af-van-toggle"><input data-af-use-van type="checkbox"> Use my saved van dimensions when matching</label><p data-af-van-summary></p></fieldset>
          </div>
          <p class="af-live-selection"><span>Current search</span><strong data-af-live-selection></strong></p>
        </div>
      </section>
    </div>
  </section>

  <section class="af-discovery-shell" data-af-discovery>
    <div class="af-results-panel">
      <div class="af-results-top" id="af-results-heading" data-af-results-heading>
        <div><p class="af-kicker">Your next adventures</p><h2>Best matches for you</h2><p data-af-summary></p></div>
        <span class="af-count" data-af-count></span>
      </div>
      <p class="af-stage-note" data-af-stage-note></p>
      <p class="af-accessibility-explainer" data-af-accessibility-explainer hidden></p>
      <div class="af-list" data-af-results></div>
      <p class="af-status" data-af-status aria-live="polite"></p>
    </div>

    <aside class="af-map-panel" aria-label="Map of matching places">
      <div class="af-map-search-summary">
        <span data-af-map-area>Lake District</span><span data-af-map-stay>Any stay</span><span data-af-map-drive>Within 2 hours</span><span data-af-map-matters>Any preferences</span>
        <button type="button" data-af-edit-search>Edit search</button>
      </div>
      <div class="af-map" data-af-map></div>
      <div class="af-map-route-status" data-af-route-status hidden></div>
      <div class="af-map-key"><span><i class="is-match"></i> Best matches</span><span><i></i> Other matches</span></div>
    </aside>
  </section>

  <section class="af-trust-strip" aria-label="How Adventure Finder helps">
    <div><span>⌖</span><p><strong>Close to the adventures</strong><small>Stay near the trails, waterfalls, beaches and attractions you love.</small></p></div>
    <div><span>△</span><p><strong>Hand picked for you</strong><small>Places are ranked around your travel style and priorities.</small></p></div>
    <div><span>♡</span><p><strong>What matters to you</strong><small>Tell us what’s important and we’ll prioritise it.</small></p></div>
    <div><span>✓</span><p><strong>Simple on the outside</strong><small>Powerful matching works underneath without making you configure everything.</small></p></div>
  </section>
</main>
  <footer class="site-footer">
    <div class="footer-brand"><img src="images/adventure-builder-logo.png" alt=""><div><strong>Adventure Builder</strong><p>Your adventure starts here.</p></div></div>
    <div class="footer-links"><a href="index.html">Home</a><a href="adventures.html">Adventures</a><a href="paddling.html">Paddle &amp; Kayak</a><a href="adventure-finder.html">Adventure Finder</a><a href="trip-planner.html">Trip Planner</a><a href="gallery.html">Gallery</a><a href="community.html">Community</a>
      <a href="studio.html">Studio</a><a href="index.html#download">Get the App</a><a href="terms.html">Terms</a><a href="privacy.html">Privacy</a></div>
    <p class="copyright">© <span id="year"></span> Adventure Builder. All rights reserved.</p>
  </footer>
  <div class="auth-overlay" id="auth-overlay" hidden>
    <section class="auth-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title">
      <button class="auth-close" id="auth-close" type="button" aria-label="Close account window">×</button>
      <div class="auth-brand"><img src="images/adventure-builder-logo.png" alt=""><div><strong>Adventure Builder</strong><small>One account for the website and app</small></div></div>

      <div id="auth-signed-out">
        <div class="auth-tabs" role="tablist">
          <button id="login-tab" class="auth-tab active" type="button" role="tab" aria-selected="true">Log in</button>
          <button id="register-tab" class="auth-tab" type="button" role="tab" aria-selected="false">Register</button>
        </div>

        <form id="login-form" class="auth-form">
          <h2 id="auth-title">Welcome back</h2>
          <p>Log in with your Adventure Builder account.</p>
          <label>Email<input id="login-email" name="email" type="email" autocomplete="email" required></label>
          <label>Password<input id="login-password" name="password" type="password" autocomplete="current-password" minlength="6" required></label>
          <button class="button button-primary auth-submit" type="submit">Log in</button>
        </form>

        <form id="register-form" class="auth-form" hidden>
          <h2>Create your account</h2>
          <p>Register here, then use the same details in the app.</p>
          <label>Your name<input id="register-name" name="name" type="text" autocomplete="name" maxlength="60" required></label>
          <label>Email<input id="register-email" name="email" type="email" autocomplete="email" required></label>
          <label>Password<input id="register-password" name="password" type="password" autocomplete="new-password" minlength="6" required></label>
          <label>Confirm password<input id="register-confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required></label>
          <label class="checkbox-row"><input id="register-terms" type="checkbox" required><span>I agree to the Adventure Builder <a href="terms.html" target="_blank" rel="noopener">Terms &amp; Conditions</a> and <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</span></label>
          <button class="button button-primary auth-submit" type="submit">Create account</button>
        </form>
      </div>

      <div id="auth-signed-in" class="account-panel" hidden>
        <div class="account-avatar account-avatar-large" id="panel-avatar">A</div>
        <p class="eyebrow">Adventure Builder account</p>
        <h2 id="panel-name">Welcome</h2>
        <p id="panel-email"></p>
        <p class="account-choice-copy">Choose how you would like to continue.</p>
        <div class="account-choice-actions">
          <button class="button button-primary" id="continue-website" type="button">Continue on Website</button>
          <a class="button button-secondary" href="https://app.adventurebuilder.co.uk" target="_blank" rel="noopener">Open the App</a>
        </div>
        <button class="account-settings-link" id="account-settings" type="button">Account settings</button>
        <button class="button button-secondary auth-submit logout-button" id="logout-button" type="button">Log out</button>
      </div>

      <p class="auth-status" id="auth-status" aria-live="polite"></p>
    </section>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/config.js"></script>
  <script src="js/accessibility-core.js"></script>
  <script src="js/profile-core.js"></script>
  <script src="js/auth-service.js"></script>
  <script src="js/auth.js"></script>
  <script src="js/account-gate.js"></script>
  <script src="js/accessibility-ui.js"></script>
  <script src="js/profile-ui.js"></script>
  <script src="js/community-counter.js"></script>
  <script src="js/feedback.js"></script>
  <script src="js/navigation-shell.js"></script>
  <script src="js/main.js"></script>
  <script src="https://unpkg.com/maplibre-gl@5.7.1/dist/maplibre-gl.js"></script>
  <script src="js/adventure-finder-data.js"></script>
  <script src="js/adventure-finder-state.js"></script>
  <script src="js/adventure-finder-score.js"></script>
  <script src="js/adventure-finder-map.js"></script>
  <script src="js/adventure-finder.js"></script>
</body>
</html>
