:root{--af-orange:#f97316;--af-orange2:#ff8a1d;--af-ink:#132028;--af-deep:#0d232b;--af-panel:#102832;--af-panel2:#16333d;--af-line:rgba(255,255,255,.12);--af-soft:#f5f3ee;--af-green:#2f7141}
*{box-sizing:border-box}.af-page-shell{background:#f5f3ee;color:var(--af-ink);overflow:hidden}.af-hero{position:relative;min-height:570px;background:url('../images/page-headers/finder.jpg') center/cover no-repeat;display:flex;align-items:center}.af-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,18,22,.8) 0%,rgba(8,18,22,.56) 46%,rgba(8,18,22,.12) 78%),linear-gradient(0deg,rgba(8,18,22,.45),transparent 55%)}.af-hero-content{position:relative;z-index:2;width:min(1240px,calc(100% - 48px));margin:auto;padding:54px 0 34px;color:#fff}.af-eyebrow,.af-kicker{text-transform:uppercase;letter-spacing:.12em;font-size:.74rem;font-weight:900;color:var(--af-orange);margin:0 0 10px}.af-hero h1{font-size:clamp(2.6rem,5vw,5rem);line-height:.95;letter-spacing:-.045em;margin:0;max-width:760px;color:#fff}.af-hero h1 span{color:#ff7b16}.af-hero-copy{font-size:1.04rem;line-height:1.55;max-width:690px;margin:20px 0 28px;color:rgba(255,255,255,.9)}.ab-finder{position:relative}.af-search-strip{display:grid;grid-template-columns:1.05fr 1.05fr .95fr 1.05fr;max-width:1020px;background:#fff;border-radius:16px;box-shadow:0 18px 44px rgba(0,0,0,.22);overflow:hidden;color:#172126}.af-search-cell{position:relative;min-height:82px;padding:15px 15px 13px 50px;border:0;border-right:1px solid #e5e7e9;background:#fff;text-align:left;font:inherit;color:inherit;cursor:pointer}.af-search-cell:last-child{border-right:0}.af-search-icon{position:absolute;left:18px;top:24px;font-size:1.45rem;color:#101820}.af-search-text{display:block;pointer-events:none}.af-search-text strong{display:block;font-size:.84rem;line-height:1.2;margin-bottom:4px}.af-search-text small{color:#7a858a;font-size:.71rem}.af-search-cell input,.af-search-cell select{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.af-matters{width:100%}.af-hero-actions{display:flex;align-items:center;gap:16px;margin-top:18px}.af-find-button{border:0;border-radius:12px;padding:17px 28px;min-width:320px;background:linear-gradient(135deg,var(--af-orange),var(--af-orange2));color:#fff;font-weight:900;letter-spacing:.02em;font-size:.92rem;box-shadow:0 12px 30px rgba(249,115,22,.3);cursor:pointer}.af-find-button span{float:right;font-size:1.25rem}.af-accessibility-toggle{border:1px solid rgba(255,255,255,.3);background:rgba(10,24,30,.55);color:#fff;border-radius:12px;padding:10px 14px;display:flex;gap:8px;align-items:center;cursor:pointer;backdrop-filter:blur(8px)}.af-accessibility-toggle small{color:rgba(255,255,255,.65)}.af-hero-note{max-width:760px;margin:16px 0 0;font-size:.77rem;color:rgba(255,255,255,.82);display:flex;gap:8px;align-items:flex-start}.af-hero-note span{color:var(--af-orange);font-weight:900}.af-filter-panel{display:none;position:absolute;left:0;top:calc(100% + 16px);width:min(950px,100%);z-index:12;background:#fff;color:#172126;border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,.32);padding:22px}.af-filter-panel.is-open{display:block}.af-filter-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;border-bottom:1px solid #e9ecee;padding-bottom:14px}.af-filter-head h2{font-size:1.25rem;margin:0}.af-link{border:0;background:none;color:var(--af-orange);font-weight:800;cursor:pointer}.af-filter-groups{display:grid;grid-template-columns:1fr 1.35fr 1fr;gap:18px;padding-top:18px}.af-filter-groups fieldset{border:0;margin:0;padding:0}.af-filter-groups legend{font-weight:850;font-size:.82rem;margin-bottom:10px}.af-options{display:flex;flex-wrap:wrap;gap:7px}.af-options button{border:1px solid #d8dde0;background:#fff;border-radius:999px;padding:8px 11px;font-size:.74rem;cursor:pointer}.af-options button[aria-pressed="true"]{background:#fff2e8;border-color:#ff8b39;color:#ba4a00}.af-van-fieldset{grid-column:1/-1;border-top:1px solid #eceff0!important;padding-top:14px!important}.af-van-toggle{font-size:.8rem}.af-live-selection{display:flex;gap:9px;margin:14px 0 0;font-size:.76rem}.af-live-selection span{color:#7b8589}
.af-discovery-shell{width:min(1440px,100%);margin:-1px auto 0;display:grid;grid-template-columns:390px 1fr;min-height:650px;background:var(--af-deep);box-shadow:0 -12px 32px rgba(0,0,0,.12)}.af-results-panel{background:linear-gradient(180deg,#0f2730,#10242c);color:#fff;padding:24px 20px;overflow:auto;max-height:720px}.af-results-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding-bottom:14px;border-bottom:1px solid var(--af-line)}.af-results-top h2{font-size:1.28rem;margin:0;color:#fff}.af-results-top p[data-af-summary]{font-size:.71rem;color:#aab8bd;margin:4px 0 0}.af-count{white-space:nowrap;font-size:.72rem;color:#f2b27d;background:rgba(249,115,22,.12);border:1px solid rgba(249,115,22,.28);padding:7px 9px;border-radius:999px}.af-stage-note{display:none}.af-list{display:grid;gap:10px;padding-top:14px}.af-result{display:grid;grid-template-columns:116px 1fr;background:#17323b;border:1px solid transparent;border-radius:12px;overflow:hidden;transition:.18s ease;cursor:pointer}.af-result:hover,.af-result.is-active{border-color:var(--af-orange);background:#193842;transform:translateY(-1px)}.af-result-visual{position:relative;min-height:124px;background-size:cover;background-position:center}.af-result-visual:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,16,20,.4),transparent 60%)}.af-result-match{position:absolute;left:8px;bottom:8px;z-index:2;background:var(--af-orange);color:#fff;border-radius:8px;padding:5px 7px;font-size:.68rem;font-weight:900}.af-result-copy{padding:11px 11px 10px;min-width:0}.af-result-heading{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.af-result-heading p{display:none}.af-result-heading h3{font-size:.92rem;line-height:1.2;margin:0;color:#fff}.af-result-badges{display:none}.af-result-summary{font-size:.68rem;line-height:1.35;color:#bac6ca;margin:6px 0 7px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.af-reasons{display:flex;flex-wrap:wrap;gap:5px 9px;list-style:none;padding:0;margin:0}.af-reasons li{font-size:.62rem;color:#d6dee0}.af-reasons li span{color:var(--af-orange);font-weight:900}.af-reasons li small{color:#8fa1a6}.af-result-actions{display:flex;align-items:center;gap:6px;margin-top:9px}.af-result-actions .af-link{padding:0;font-size:.64rem}.af-result-actions span{flex:1}.af-btn{border-radius:8px;padding:7px 9px;border:1px solid transparent;font-weight:800;font-size:.63rem;cursor:pointer}.af-btn.secondary{background:transparent;border-color:#53676d;color:#dce5e7}.af-btn.primary{background:var(--af-orange);color:#fff}.af-missing,.af-access-unknown{display:none}.af-status,.af-accessibility-explainer{font-size:.72rem;color:#b9c7ca}.af-map-panel{position:relative;min-width:0;background:#d9e3d0}.af-map{position:absolute;inset:0;min-height:650px}.af-map-search-summary{position:absolute;z-index:5;top:18px;left:18px;right:18px;display:flex;align-items:center;gap:0;background:#fff;border-radius:13px;box-shadow:0 8px 26px rgba(16,35,43,.18);overflow:hidden;max-width:860px}.af-map-search-summary span{padding:13px 16px;border-right:1px solid #e5e8e9;font-size:.72rem;font-weight:750;white-space:nowrap}.af-map-search-summary button{margin-left:auto;border:0;background:var(--af-orange);color:#fff;font-size:.7rem;font-weight:900;padding:15px 18px;cursor:pointer}.af-map-key{position:absolute;left:20px;bottom:20px;z-index:4;background:#fff;border-radius:10px;padding:8px 11px;display:flex;gap:14px;box-shadow:0 6px 20px rgba(0,0,0,.14);font-size:.65rem}.af-map-key i{display:inline-block;width:9px;height:9px;border-radius:50%;background:#172d35;margin-right:5px}.af-map-key i.is-match{background:var(--af-orange)}.af-map-marker{width:32px;height:42px;border:0;background:var(--af-orange);clip-path:polygon(50% 100%,0 40%,8% 17%,28% 3%,50% 0,72% 3%,92% 17%,100% 40%);cursor:pointer;filter:drop-shadow(0 4px 4px rgba(0,0,0,.28))}.af-map-marker span{display:block;width:12px;height:12px;border-radius:50%;background:#fff;margin:8px auto}.af-map-marker.is-active{transform:scale(1.18);background:#ff5a00}.maplibregl-popup-content{border-radius:12px}.af-trust-strip{width:min(1440px,100%);margin:auto;background:#fff;display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:24px 28px;border-top:1px solid #e8e5df}.af-trust-strip>div{display:flex;gap:13px;align-items:flex-start;padding:0 20px;border-right:1px solid #e9e7e2}.af-trust-strip>div:last-child{border-right:0}.af-trust-strip>div>span{font-size:1.55rem;color:var(--af-orange)}.af-trust-strip p{margin:0}.af-trust-strip strong{display:block;font-size:.83rem}.af-trust-strip small{display:block;color:#737d80;line-height:1.35;margin-top:3px}.site-footer{margin-top:0}
@media(max-width:980px){.af-hero{min-height:auto}.af-hero-content{padding:44px 0}.af-search-strip{grid-template-columns:1fr 1fr}.af-search-cell:nth-child(2){border-right:0}.af-search-cell:nth-child(-n+2){border-bottom:1px solid #e5e7e9}.af-discovery-shell{grid-template-columns:340px 1fr}.af-map-search-summary span:nth-child(n+3){display:none}.af-trust-strip{grid-template-columns:1fr 1fr;row-gap:20px}.af-trust-strip>div:nth-child(2){border-right:0}.af-filter-groups{grid-template-columns:1fr 1fr}}
@media(max-width:720px){.af-hero-content{width:min(100% - 28px,1240px)}.af-hero h1{font-size:2.55rem}.af-hero-copy{font-size:.92rem}.af-search-strip{grid-template-columns:1fr}.af-search-cell{min-height:70px;border-right:0;border-bottom:1px solid #e5e7e9}.af-search-cell:last-child{border-bottom:0}.af-search-icon{top:19px}.af-hero-actions{align-items:stretch;flex-direction:column}.af-find-button{min-width:0;width:100%}.af-accessibility-toggle{justify-content:center}.af-filter-panel{position:relative;top:auto;margin-top:12px}.af-filter-groups{grid-template-columns:1fr}.af-discovery-shell{display:flex;flex-direction:column}.af-results-panel{order:2;max-height:none}.af-map-panel{order:1;height:430px}.af-map{min-height:430px}.af-map-search-summary{left:10px;right:10px;top:10px}.af-map-search-summary span{display:none!important}.af-map-search-summary span:first-child{display:block!important;flex:1}.af-result{grid-template-columns:110px 1fr}.af-trust-strip{grid-template-columns:1fr;padding:22px 14px}.af-trust-strip>div{border-right:0;border-bottom:1px solid #e9e7e2;padding:14px 10px}.af-trust-strip>div:last-child{border-bottom:0}}


/* W72.1 — Adventure Finder bespoke visual shell.
   The site-wide compact stylesheet intentionally normalises other feature pages,
   so Finder reasserts its approved scenic/split-view presentation here. */
body[data-page="adventure-finder"] .af-hero{
  padding:0!important;
  min-height:520px!important;
  background-image:url('../images/page-headers/finder.jpg')!important;
  background-position:center center!important;
  background-size:cover!important;
  background-repeat:no-repeat!important;
  border:0!important;
  color:#fff!important;
}
body[data-page="adventure-finder"] .af-hero::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:0;
  background:linear-gradient(90deg,rgba(7,19,24,.88) 0%,rgba(7,19,24,.67) 38%,rgba(7,19,24,.26) 70%,rgba(7,19,24,.08) 100%);
  pointer-events:none;
}
body[data-page="adventure-finder"] .af-hero::after{
  background:linear-gradient(0deg,rgba(5,16,20,.52) 0%,rgba(5,16,20,.08) 52%,transparent 82%)!important;
  z-index:0;
}
body[data-page="adventure-finder"] .af-hero-overlay{display:none!important}
body[data-page="adventure-finder"] .af-hero-content{
  width:min(1180px,calc(100% - 56px));
  padding:58px 0 34px!important;
  color:#fff!important;
}
body[data-page="adventure-finder"] .af-hero :is(h1,h2,h3){color:#fff!important}
body[data-page="adventure-finder"] .af-hero h1{font-size:clamp(2.7rem,4.7vw,4.9rem)!important;line-height:.98!important;max-width:720px}
body[data-page="adventure-finder"] .af-hero h1 span{color:#ff7a16!important}
body[data-page="adventure-finder"] .af-hero p{color:rgba(255,255,255,.9)!important}
body[data-page="adventure-finder"] .af-eyebrow{color:#ff8a24!important}
body[data-page="adventure-finder"] .af-hero-copy{max-width:650px;margin:17px 0 24px!important}
body[data-page="adventure-finder"] .af-search-strip{
  width:min(100%,1040px);
  max-width:none;
  border-radius:15px;
  box-shadow:0 18px 46px rgba(0,0,0,.28);
}
body[data-page="adventure-finder"] .af-search-cell{min-height:78px}
body[data-page="adventure-finder"] .af-hero-actions{margin-top:15px}
body[data-page="adventure-finder"] .af-find-button{min-width:300px;padding:16px 24px}
body[data-page="adventure-finder"] .af-hero-note{margin-top:13px!important;max-width:790px}

body[data-page="adventure-finder"] .af-discovery-shell{
  width:min(1360px,calc(100% - 32px));
  margin:-22px auto 0;
  position:relative;
  z-index:5;
  grid-template-columns:minmax(330px,390px) minmax(0,1fr);
  min-height:610px;
  border-radius:18px 18px 0 0;
  overflow:hidden;
  box-shadow:0 22px 56px rgba(10,28,34,.18);
  background:#0d232b!important;
}
body[data-page="adventure-finder"] .af-results-panel{background:linear-gradient(180deg,#0e2731,#0c222a)!important;color:#fff!important;max-height:680px;padding:22px 18px}
body[data-page="adventure-finder"] .af-results-top h2,
body[data-page="adventure-finder"] .af-result-heading h3{color:#fff!important}
body[data-page="adventure-finder"] .af-result{background:#17343e!important;color:#fff!important;border-color:transparent!important;box-shadow:none!important}
body[data-page="adventure-finder"] .af-result:hover,
body[data-page="adventure-finder"] .af-result.is-active{background:#1a3b46!important;border-color:#f97316!important}
body[data-page="adventure-finder"] .af-result :is(p,small,label,span){color:inherit}
body[data-page="adventure-finder"] .af-result-summary{color:#bdc9cd!important}
body[data-page="adventure-finder"] .af-reasons li{color:#e0e7e9!important}
body[data-page="adventure-finder"] .af-map-panel{
  min-height:610px;
  background:#dbe5d7 url('../images/page-headers/generic-mountains.jpg') center/cover no-repeat;
}
body[data-page="adventure-finder"] .af-map{min-height:610px;background:rgba(222,233,218,.9)}
body[data-page="adventure-finder"] .af-map:empty::before{
  content:"Loading adventure map…";
  position:absolute;
  inset:50% auto auto 50%;
  transform:translate(-50%,-50%);
  color:#58705f;
  font-weight:800;
}
body[data-page="adventure-finder"] .af-trust-strip{width:min(1360px,calc(100% - 32px));border-radius:0 0 18px 18px;margin:0 auto 28px}

@media(max-width:980px){
  body[data-page="adventure-finder"] .af-hero{min-height:auto!important}
  body[data-page="adventure-finder"] .af-discovery-shell{grid-template-columns:330px minmax(0,1fr)}
}
@media(max-width:720px){
  body[data-page="adventure-finder"] .af-hero-content{width:min(100% - 28px,1180px);padding:38px 0 30px!important}
  body[data-page="adventure-finder"] .af-discovery-shell{width:100%;margin:0;border-radius:0;display:flex;flex-direction:column}
  body[data-page="adventure-finder"] .af-results-panel{max-height:none;order:2}
  body[data-page="adventure-finder"] .af-map-panel{order:1;min-height:430px}
  body[data-page="adventure-finder"] .af-map{min-height:430px}
  body[data-page="adventure-finder"] .af-trust-strip{width:100%;border-radius:0;margin-bottom:0}
}


/* W72.2 — compact website-blended Finder + anchored preferences dropdown */
body[data-page="adventure-finder"] .af-page-shell{background:#fff!important;overflow:visible!important}
body[data-page="adventure-finder"] .af-hero{
  min-height:390px!important;
  max-height:none!important;
  align-items:center!important;
  background-position:center 46%!important;
}
body[data-page="adventure-finder"] .af-hero-content{
  width:min(1180px,calc(100% - 48px));
  padding:28px 0 24px!important;
}
body[data-page="adventure-finder"] .af-hero h1{
  font-size:clamp(2.15rem,3.6vw,3.65rem)!important;
  line-height:1.02!important;
  max-width:650px!important;
}
body[data-page="adventure-finder"] .af-hero-copy{
  max-width:620px!important;
  margin:12px 0 16px!important;
  font-size:.94rem!important;
  line-height:1.45!important;
}
body[data-page="adventure-finder"] .af-eyebrow{margin-bottom:6px!important}
body[data-page="adventure-finder"] .ab-finder{position:relative;z-index:20}
body[data-page="adventure-finder"] .af-search-strip{
  width:min(100%,1010px)!important;
  border-radius:13px!important;
}
body[data-page="adventure-finder"] .af-search-cell{
  min-height:66px!important;
  padding-top:11px!important;
  padding-bottom:9px!important;
}
body[data-page="adventure-finder"] .af-search-icon{top:18px!important}
body[data-page="adventure-finder"] .af-search-text strong{font-size:.8rem!important}
body[data-page="adventure-finder"] .af-hero-actions{margin-top:12px!important;gap:12px!important}
body[data-page="adventure-finder"] .af-find-button{
  min-width:285px!important;
  padding:13px 22px!important;
  border-radius:10px!important;
}
body[data-page="adventure-finder"] .af-accessibility-toggle{padding:8px 12px!important;border-radius:10px!important}
body[data-page="adventure-finder"] .af-hero-note{margin-top:9px!important;font-size:.72rem!important}
body[data-page="adventure-finder"] .af-filter-panel{
  position:absolute!important;
  left:0!important;
  top:74px!important;
  width:min(960px,100%)!important;
  max-height:min(390px,calc(100vh - 160px));
  overflow:auto;
  z-index:1000!important;
  margin:0!important;
  border:1px solid #e7e9ea!important;
  border-radius:14px!important;
  box-shadow:0 20px 60px rgba(8,24,31,.28)!important;
}
body[data-page="adventure-finder"] .af-filter-panel.is-open{display:block!important}
body[data-page="adventure-finder"] .af-discovery-shell{
  width:min(1280px,calc(100% - 40px))!important;
  margin:18px auto 0!important;
  grid-template-columns:minmax(320px,370px) minmax(0,1fr)!important;
  min-height:560px!important;
  border-radius:16px!important;
  box-shadow:0 16px 46px rgba(19,32,40,.14)!important;
}
body[data-page="adventure-finder"] .af-results-panel{max-height:620px!important;padding:20px 16px!important}
body[data-page="adventure-finder"] .af-map-panel{min-height:560px!important}
body[data-page="adventure-finder"] .af-map{min-height:560px!important}
body[data-page="adventure-finder"] .af-map-search-summary{top:14px!important;left:14px!important;right:14px!important}
body[data-page="adventure-finder"] .af-map-route-status{
  position:absolute;z-index:5;left:18px;bottom:18px;background:rgba(13,35,43,.92);color:#fff;
  border-radius:10px;padding:8px 11px;font-size:.7rem;font-weight:750;box-shadow:0 6px 18px rgba(0,0,0,.2)
}
body[data-page="adventure-finder"] .af-trust-strip{
  width:min(1280px,calc(100% - 40px))!important;
  margin:0 auto 26px!important;
  border-radius:0 0 16px 16px!important;
  background:#fff!important;
}
@media(max-width:980px){
  body[data-page="adventure-finder"] .af-hero{min-height:360px!important}
  body[data-page="adventure-finder"] .af-discovery-shell{grid-template-columns:320px minmax(0,1fr)!important}
}
@media(max-width:720px){
  body[data-page="adventure-finder"] .af-page-shell{overflow:hidden!important}
  body[data-page="adventure-finder"] .af-hero{min-height:auto!important}
  body[data-page="adventure-finder"] .af-hero-content{width:min(100% - 28px,1180px);padding:28px 0 24px!important}
  body[data-page="adventure-finder"] .af-filter-panel{position:relative!important;top:auto!important;max-height:none;margin-top:10px!important}
  body[data-page="adventure-finder"] .af-discovery-shell{width:100%!important;margin:0!important;border-radius:0!important;display:flex!important;flex-direction:column!important}
  body[data-page="adventure-finder"] .af-map-panel,body[data-page="adventure-finder"] .af-map{min-height:410px!important}
  body[data-page="adventure-finder"] .af-trust-strip{width:100%!important;margin-bottom:0!important;border-radius:0!important}
}


/* W72.3 — desktop space-use polish: single-line title, left-led search, wider dark results, white cards */
@media (min-width:1100px){
  body[data-page="adventure-finder"] .af-hero-content{
    width:min(1360px,calc(100% - 56px))!important;
    margin-left:auto!important;margin-right:auto!important;
    padding:24px 0 22px!important;
  }
  body[data-page="adventure-finder"] .af-hero h1{
    max-width:none!important;
    white-space:nowrap!important;
    font-size:clamp(2.15rem,3.25vw,3.45rem)!important;
    letter-spacing:-.04em!important;
  }
  body[data-page="adventure-finder"] .af-hero-copy{margin:9px 0 13px!important;max-width:690px!important}
  body[data-page="adventure-finder"] .af-search-strip{width:min(100%,1080px)!important;margin-left:0!important}
  body[data-page="adventure-finder"] .af-discovery-shell{
    width:min(1360px,calc(100% - 40px))!important;
    grid-template-columns:minmax(410px,450px) minmax(0,1fr)!important;
  }
  body[data-page="adventure-finder"] .af-trust-strip{width:min(1360px,calc(100% - 40px))!important}
}
body[data-page="adventure-finder"] .af-results-panel{
  background:#0b0d0f!important;
  color:#fff!important;
}
body[data-page="adventure-finder"] .af-result{
  background:#fff!important;
  color:#172126!important;
  border:1px solid #e4e7e8!important;
  box-shadow:0 4px 14px rgba(0,0,0,.12)!important;
}
body[data-page="adventure-finder"] .af-result:hover,
body[data-page="adventure-finder"] .af-result.is-active{
  background:#fff!important;
  border-color:#f97316!important;
  box-shadow:0 6px 20px rgba(249,115,22,.18)!important;
}
body[data-page="adventure-finder"] .af-result-heading h3{color:#172126!important}
body[data-page="adventure-finder"] .af-result :is(p,small,label,span){color:inherit}
body[data-page="adventure-finder"] .af-result-summary{color:#5e696e!important}
body[data-page="adventure-finder"] .af-reasons li{color:#364247!important}
body[data-page="adventure-finder"] .af-reasons li small{color:#718086!important}
body[data-page="adventure-finder"] .af-result-actions .af-link{color:#d95f09!important}
body[data-page="adventure-finder"] .af-btn.secondary{border-color:#cbd1d4!important;color:#263238!important;background:#fff!important}
@media(max-width:1099px){body[data-page="adventure-finder"] .af-hero h1{white-space:normal!important}}

/* W72.4 — compact What Matters popover + clear-results control */
body[data-page="adventure-finder"] .af-matters-wrap{position:relative;min-width:0}
body[data-page="adventure-finder"] .af-matters-wrap>.af-search-cell{height:100%;border-right:0!important}
body[data-page="adventure-finder"] .af-filter-panel{
  left:auto!important;
  right:0!important;
  top:calc(100% + 8px)!important;
  width:min(690px,calc(100vw - 56px))!important;
  max-height:min(360px,calc(100vh - 180px))!important;
  padding:16px!important;
  overflow:auto!important;
  overscroll-behavior:contain;
}
body[data-page="adventure-finder"] .af-filter-head{padding-bottom:10px!important;align-items:center!important}
body[data-page="adventure-finder"] .af-filter-head h2{font-size:1rem!important;line-height:1.2!important}
body[data-page="adventure-finder"] .af-filter-head .af-kicker{margin-bottom:3px!important;font-size:.64rem!important}
body[data-page="adventure-finder"] .af-filter-groups{grid-template-columns:1fr 1.25fr 1fr!important;gap:12px!important;padding-top:12px!important}
body[data-page="adventure-finder"] .af-filter-groups legend{font-size:.74rem!important;margin-bottom:7px!important}
body[data-page="adventure-finder"] .af-options{gap:6px!important}
body[data-page="adventure-finder"] .af-options button{padding:7px 9px!important;font-size:.68rem!important}
body[data-page="adventure-finder"] .af-van-fieldset{padding-top:10px!important}
body[data-page="adventure-finder"] .af-filter-footer{display:flex;align-items:center;gap:12px;justify-content:space-between;border-top:1px solid #eceff0;margin-top:12px;padding-top:10px;position:sticky;bottom:-16px;background:#fff;padding-bottom:2px}
body[data-page="adventure-finder"] .af-live-selection{margin:0!important;min-width:0;display:block!important}
body[data-page="adventure-finder"] .af-live-selection span{display:block;font-size:.62rem;margin-bottom:2px}
body[data-page="adventure-finder"] .af-live-selection strong{display:block;font-size:.68rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:490px}
body[data-page="adventure-finder"] .af-filter-done{border:0;background:#f97316;color:#fff;border-radius:8px;padding:8px 16px;font-size:.72rem;font-weight:900;cursor:pointer;flex:0 0 auto}
body[data-page="adventure-finder"] .af-results-tools{display:flex;align-items:center;gap:8px;flex:0 0 auto}
body[data-page="adventure-finder"] .af-clear-results{border:1px solid rgba(255,255,255,.24);background:transparent;color:#fff;border-radius:999px;padding:7px 10px;font-size:.66rem;font-weight:850;cursor:pointer;white-space:nowrap}
body[data-page="adventure-finder"] .af-clear-results:hover{border-color:#f97316;color:#ff9a55}
body[data-page="adventure-finder"] .af-results-panel.is-cleared .af-list{min-height:130px;display:grid;place-items:center}
body[data-page="adventure-finder"] .af-cleared-state{text-align:center;color:#aeb9bd;padding:26px 12px}
body[data-page="adventure-finder"] .af-cleared-state strong{display:block;color:#fff;font-size:.95rem;margin-bottom:5px}
body[data-page="adventure-finder"] .af-cleared-state small{font-size:.72rem;line-height:1.4}
@media(max-width:980px){
  body[data-page="adventure-finder"] .af-filter-panel{width:min(620px,calc(100vw - 40px))!important}
  body[data-page="adventure-finder"] .af-filter-groups{grid-template-columns:1fr 1fr!important}
}
@media(max-width:720px){
  body[data-page="adventure-finder"] .af-matters-wrap{position:static}
  body[data-page="adventure-finder"] .af-filter-panel{position:absolute!important;left:0!important;right:0!important;top:calc(100% + 8px)!important;width:100%!important;max-height:55vh!important;margin:0!important}
  body[data-page="adventure-finder"] .af-filter-groups{grid-template-columns:1fr!important}
  body[data-page="adventure-finder"] .af-live-selection strong{max-width:220px}
  body[data-page="adventure-finder"] .af-results-top{gap:8px}
  body[data-page="adventure-finder"] .af-results-tools{flex-direction:column;align-items:flex-end;gap:5px}
}


/* W72.5 — fix What Matters, full-width discovery workspace, remove map overlay banner */
body[data-page="adventure-finder"] .af-search-strip{
  overflow:visible!important;
}
body[data-page="adventure-finder"] .af-search-strip>.af-search-cell:first-child{
  border-radius:13px 0 0 13px;
}
body[data-page="adventure-finder"] .af-matters-wrap>.af-search-cell{
  border-radius:0 13px 13px 0;
}
body[data-page="adventure-finder"] .af-filter-panel{
  z-index:2000!important;
}
body[data-page="adventure-finder"] .af-discovery-shell{
  width:100%!important;
  max-width:none!important;
  margin:14px 0 0!important;
  grid-template-columns:minmax(430px,34vw) minmax(0,1fr)!important;
  border-radius:0!important;
  box-shadow:0 12px 34px rgba(19,32,40,.14)!important;
}
body[data-page="adventure-finder"] .af-results-panel{
  width:100%!important;
  max-height:680px!important;
}
body[data-page="adventure-finder"] .af-map-panel,
body[data-page="adventure-finder"] .af-map{
  min-height:620px!important;
}
body[data-page="adventure-finder"] .af-map-search-summary{display:none!important}
body[data-page="adventure-finder"] .af-trust-strip{
  width:100%!important;
  max-width:none!important;
  border-radius:0!important;
  margin:0!important;
}
@media(max-width:1100px){
  body[data-page="adventure-finder"] .af-discovery-shell{grid-template-columns:minmax(360px,40vw) minmax(0,1fr)!important}
}
@media(max-width:720px){
  body[data-page="adventure-finder"] .af-search-strip{overflow:visible!important}
  body[data-page="adventure-finder"] .af-search-strip>.af-search-cell:first-child{border-radius:13px 13px 0 0}
  body[data-page="adventure-finder"] .af-matters-wrap>.af-search-cell{border-radius:0 0 13px 13px}
  body[data-page="adventure-finder"] .af-discovery-shell{width:100%!important;display:flex!important;flex-direction:column!important}
  body[data-page="adventure-finder"] .af-map-panel,body[data-page="adventure-finder"] .af-map{min-height:410px!important}
}
