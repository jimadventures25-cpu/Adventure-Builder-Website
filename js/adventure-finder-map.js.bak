(() => {
  'use strict';
  const instances=new WeakMap();

  function mapStyle(){
    return {
      version:8,
      sources:{osm:{type:'raster',tiles:['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],tileSize:256,attribution:'© OpenStreetMap contributors'}},
      layers:[{id:'osm',type:'raster',source:'osm'}]
    };
  }

  function markerElement(result,isActive){
    const el=document.createElement('button');
    el.type='button';
    el.className=`af-map-marker${isActive?' is-active':''}`;
    el.dataset.placeId=result.id;
    el.setAttribute('aria-label',`${result.name}, ${result.matchLabel}`);
    el.innerHTML='<span></span>';
    return el;
  }

  function ensureRouteLayer(state){
    if(!state.map.isStyleLoaded()) return false;
    if(!state.map.getSource('af-valhalla-route')){
      state.map.addSource('af-valhalla-route',{type:'geojson',data:{type:'FeatureCollection',features:[]}});
      state.map.addLayer({id:'af-valhalla-route-casing',type:'line',source:'af-valhalla-route',paint:{'line-color':'#ffffff','line-width':7,'line-opacity':.92}});
      state.map.addLayer({id:'af-valhalla-route-line',type:'line',source:'af-valhalla-route',paint:{'line-color':'#f97316','line-width':4,'line-opacity':1}});
    }
    return true;
  }

  function init(root,onSelect){
    const container=root.querySelector('[data-af-map]');
    if(!container || !window.maplibregl) return null;
    const map=new maplibregl.Map({container,style:mapStyle(),center:[-3.2,54.4],zoom:5.2,attributionControl:true});
    map.addControl(new maplibregl.NavigationControl({showCompass:false}),'top-right');
    const state={map,markers:[],activeId:null,onSelect,routeAbort:null};
    instances.set(root,state);
    map.on('load',()=>ensureRouteLayer(state));
    return state;
  }

  function clear(state){
    state.markers.forEach(marker=>{try{marker.remove()}catch{}});
    state.markers=[];
  }

  function clearRoute(root){
    const state=instances.get(root); if(!state)return;
    const src=state.map.getSource('af-valhalla-route');
    if(src) src.setData({type:'FeatureCollection',features:[]});
    const label=root.closest('.af-page-shell')?.querySelector('[data-af-route-status]');
    if(label){label.hidden=true;label.textContent='';}
  }

  function render(root,results,activeId=null){
    let state=instances.get(root);
    if(!state) state=init(root,id=>root.dispatchEvent(new CustomEvent('af:select',{detail:{id}})));
    if(!state) return;
    state.activeId=activeId;
    clear(state);
    clearRoute(root);
    const bounds=new maplibregl.LngLatBounds();
    results.forEach(result=>{
      if(!Array.isArray(result.coords)||result.coords.length!==2)return;
      const el=markerElement(result,result.id===activeId);
      el.addEventListener('click',()=>state.onSelect(result.id));
      const marker=new maplibregl.Marker({element:el,anchor:'bottom'}).setLngLat(result.coords).addTo(state.map);
      state.markers.push(marker); bounds.extend(result.coords);
    });
    if(!bounds.isEmpty()) state.map.fitBounds(bounds,{padding:70,maxZoom:10,duration:350});
    setTimeout(()=>state.map.resize(),0);
  }

  function focus(root,result){
    const state=instances.get(root); if(!state||!result?.coords)return;
    state.map.flyTo({center:result.coords,zoom:10.5,duration:500});
  }

  async function route(root,from,result){
    const state=instances.get(root); if(!state||!from||!result?.coords)return null;
    if(state.routeAbort) state.routeAbort.abort();
    state.routeAbort=new AbortController();
    const label=root.closest('.af-page-shell')?.querySelector('[data-af-route-status]');
    if(label){label.hidden=false;label.textContent='Calculating drive route…';}
    try{
      const response=await fetch('/.netlify/functions/adventure-finder-route',{
        method:'POST',headers:{'Content-Type':'application/json'},signal:state.routeAbort.signal,
        body:JSON.stringify({from:{lon:from[0],lat:from[1]},to:{lon:result.coords[0],lat:result.coords[1]}})
      });
      const payload=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(payload.error||'Route could not be calculated.');
      const route=payload.route;
      if(!route?.geometry?.coordinates?.length) throw new Error('Valhalla returned no route geometry.');
      if(!ensureRouteLayer(state)) await new Promise(resolve=>state.map.once('load',resolve));
      ensureRouteLayer(state);
      state.map.getSource('af-valhalla-route')?.setData({type:'Feature',properties:{provider:payload.provider||'valhalla'},geometry:route.geometry});
      const bounds=route.geometry.coordinates.reduce((b,c)=>b.extend(c),new maplibregl.LngLatBounds(route.geometry.coordinates[0],route.geometry.coordinates[0]));
      state.map.fitBounds(bounds,{padding:{top:85,bottom:55,left:55,right:55},maxZoom:12,duration:500});
      const mins=Math.max(1,Math.round((Number(route.duration)||0)/60));
      const miles=(Number(route.distance)||0)/1609.344;
      if(label){label.hidden=false;label.textContent=`Valhalla route · ${mins} min · ${miles.toFixed(1)} mi`;}
      return {duration:route.duration,distance:route.distance,provider:payload.provider||'valhalla'};
    }catch(error){
      if(error?.name==='AbortError') return null;
      clearRoute(root);
      if(label){label.hidden=false;label.textContent='Route unavailable — showing location only.';}
      return null;
    }
  }

  window.AdventureFinderMap = Object.freeze({init,render,focus,route,clearRoute});
})();
